<div id="login">
  <p><img src="img/rabbitmqlogo.svg" alt="RabbitMQ logo" width="204" height="37"/></p>
  <!-- begin login status -->
  <div id="login-status">
    <% if (Array.isArray(escaped_warnings)) { %>
        <% for (var i = 0; i < escaped_warnings.length; i++) { %>
        <p class="warning"><%=escaped_warnings[i]%> </p>
        <% } %>
    <% } %>
    <% if (notAuthorized) { %>
        <button id="logout" data-oauth-action="logout">Click here to logout</button>
    <% } %>
  </div>
<% if (!notAuthorized) { %>
  <% var oauth2Options = auth_options_for_mechanism(auth, 'oauth2'); %>
  <% var basicOptions = auth_options_for_mechanism(auth, 'basic'); %>
  <% if (auth.mode == 'none') { %>
    <p class="warning">There is no authentication mechanism available to log in with.</p>
  <% } else if (auth.mode == 'single' && oauth2Options.length == 1) { %>
    <button id="login" data-oauth-action="login" data-resource-id="<%=fmt_string(oauth2Options[0].id)%>">Click here to log in</button>
  <% } else { %>
    <% if (auth.mode == 'choice') { %>
    <b>Login with :</b>
    <p/>
    <% } %>
    <!-- begin login with oauth2  -->
    <% if (oauth2Options.length > 0) { %>
    <div class="section disable-pref <%= auth_section_is_expanded(auth, 'oauth2') ? 'section-visible' : 'section-invisible' %>" id="login-with-oauth2">
      <h2>OAuth 2.0</h2>
      <div class="hider">
        <div class="updatable">
          <% if (oauth2Options.length == 1) { %>
          <button id="login" data-oauth-action="login" data-resource-id="<%=fmt_string(oauth2Options[0].id)%>">Click here to log in</button>
          <% } else { %>
          <form id="oauth2-resource-form">
            <label for="oauth2-resource">Resource: </label>
            <select id="oauth2-resource">
              <% for (var i = 0; i < oauth2Options.length; i++) { %>
               <option value="<%= fmt_string(oauth2Options[i].id) %>" <%= (auth.preselected === oauth2Options[i].id) ? 'selected="selected"' : '' %>>
                 <%= fmt_string(oauth2Options[i].label) %>
               </option>
              <% } %>
            </select>
            <p/>
            <button id="login" type="submit">Click here to log in</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
    <!-- end login with oauth2  -->

    <!-- begin login with basic auth   -->
    <% if (basicOptions.length > 0) { %>
    <div class="section disable-pref <%= auth_section_is_expanded(auth, 'basic') ? 'section-visible' : 'section-invisible' %>" id="login-with-basic-auth">
      <h2>Basic Authentication</h2>
      <div class="hider">
        <div class="updatable">
          <form action="#/login"  id="basic-auth-form" method="put">
          <table class="form">
            <tr>
              <th><label>Username:</label></th>
              <td><input type="text" id="username" name="username" autocomplete="username"/><span class="mand">*</span></td>
            </tr>
            <tr>
              <th><label>Password:</label></th>
              <td><input type="password" id="password" name="password" autocomplete="current-password"/><span class="mand">*</span></td>
            </tr>
            <tr>
              <th>&nbsp;</th>
              <td><input type="submit" value="Login"/></td>
            </tr>
          </table>
          </form>
        </div>
      </div>
    </div>
    <% } %>
    <!-- end login with basic auth  -->
  <% } %>
<% } %>

</div> <!-- login -->
